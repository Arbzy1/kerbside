# Neon Postgres connection string used by migrate, seed, API, and tests.
# Use an owner/privileged role for db:migrate and db:seed. The RLS migration
# creates NOLOGIN role kerbside_app (SELECT-only); negative RLS tests SET ROLE to it.
# Staging and production each use a separate Neon database URL (never share).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Web API origin baked into the Vite build (VITE_* is build-time).
# Local turbo/Vite: leave unset so /api and /health proxy to Wrangler (8787).
# Staging build: Worker URL for kerbside-api-staging (set STAGING_API_URL in CI).
# Production build: Worker URL for kerbside-api (set PRODUCTION_API_URL in CI).
# Cold-API check: point at a dead port, e.g. http://127.0.0.1:59999
# VITE_API_URL=http://127.0.0.1:8787

# Better Auth signing secret — generate a long random string before enabling auth.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Resend API key for transactional email — leave unset until email is wired.
RESEND_API_KEY=re_xxxxxxxx
