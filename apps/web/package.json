{
  "name": "@kerbside/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview",
    "deploy:staging": "tsc -b && vite build && wrangler pages deploy dist --project-name=kerbside-web-staging",
    "deploy:prod": "tsc -b && vite build && wrangler pages deploy dist --project-name=kerbside-web"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@kerbside/shared": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^8.1.1",
    "wrangler": "^4.19.1"
  }
}
